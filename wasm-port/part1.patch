diff --git a/src/nnue/layers/affine_transform.h b/src/nnue/layers/affine_transform.h
index a3d072f6..ba9c1c66 100644
--- a/src/nnue/layers/affine_transform.h
+++ b/src/nnue/layers/affine_transform.h
@@ -106,6 +106,45 @@ static void affine_transform_non_ssse3(std::int32_t*       output,
 
         #endif
     }
+    #elif defined(USE_WASM_SIMD)
+    constexpr IndexType NumChunks = ceil_to_multiple<IndexType>(InputDimensions, 16) / 16;
+
+    // Dot product of 16 signed weights and 16 unsigned inputs as 4 partial sums
+    auto dot = [](v128_t w, v128_t x) {
+        return wasm_i32x4_add(wasm_i32x4_dot_i16x8(wasm_i16x8_extend_low_i8x16(w),
+                                                   wasm_u16x8_extend_low_u8x16(x)),
+                              wasm_i32x4_dot_i16x8(wasm_i16x8_extend_high_i8x16(w),
+                                                   wasm_u16x8_extend_high_u8x16(x)));
+    };
+    auto hadd = [](v128_t a, v128_t b) {
+        return wasm_i32x4_add(wasm_i32x4_shuffle(a, b, 0, 2, 4, 6),
+                              wasm_i32x4_shuffle(a, b, 1, 3, 5, 7));
+    };
+
+    IndexType i = 0;
+    for (; i + 4 <= OutputDimensions; i += 4)
+    {
+        v128_t s0 = wasm_i32x4_splat(0), s1 = s0, s2 = s0, s3 = s0;
+        for (IndexType j = 0; j < NumChunks; ++j)
+        {
+            const v128_t x = wasm_v128_load(&input[j * 16]);
+            s0 = wasm_i32x4_add(s0, dot(wasm_v128_load(&weights[(i + 0) * PaddedInputDimensions + j * 16]), x));
+            s1 = wasm_i32x4_add(s1, dot(wasm_v128_load(&weights[(i + 1) * PaddedInputDimensions + j * 16]), x));
+            s2 = wasm_i32x4_add(s2, dot(wasm_v128_load(&weights[(i + 2) * PaddedInputDimensions + j * 16]), x));
+            s3 = wasm_i32x4_add(s3, dot(wasm_v128_load(&weights[(i + 3) * PaddedInputDimensions + j * 16]), x));
+        }
+        wasm_v128_store(&output[i], wasm_i32x4_add(wasm_v128_load(&biases[i]),
+                                                   hadd(hadd(s0, s1), hadd(s2, s3))));
+    }
+    for (; i < OutputDimensions; ++i)
+    {
+        v128_t s = wasm_i32x4_splat(0);
+        for (IndexType j = 0; j < NumChunks; ++j)
+            s = wasm_i32x4_add(s, dot(wasm_v128_load(&weights[i * PaddedInputDimensions + j * 16]),
+                                      wasm_v128_load(&input[j * 16])));
+        output[i] = biases[i] + wasm_i32x4_extract_lane(s, 0) + wasm_i32x4_extract_lane(s, 1)
+                  + wasm_i32x4_extract_lane(s, 2) + wasm_i32x4_extract_lane(s, 3);
+    }
     #else
     std::memcpy(output, biases, sizeof(std::int32_t) * OutputDimensions);
 
